# PostgreSQL connection string for the application database.
DATABASE_URL=postgresql://postgres:your_database_password@localhost:5432/asuman_holdings

# Generate a unique secret (for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters_long

ADMIN_EMAIL=admin@asumanholdings.com
# Use a unique password with at least 12 characters. npm run seed sets/resets this admin password.
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters

# Optional. Comma-separated browser origins for production; omit for local development.
# CLIENT_ORIGIN=https://www.asumanholdings.com,https://asumanholdings.com

# Optional. Defaults to 5000.
# PORT=5000
